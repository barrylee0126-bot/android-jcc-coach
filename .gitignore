# Default deny: publish only the explicitly listed source and documentation.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/设备配置.env.example
!/src/
!/tools/
!/docs/
!/schemas/
!/tests/

# Publish only the synthetic schemas, examples and contract tests explicitly listed.
/schemas/*
!/schemas/game-state-v1.schema.json
!/schemas/examples/
/schemas/examples/*
!/schemas/examples/game-state-v1.example.json
!/schemas/examples/sample-annotation-v1.example.json
/tests/*
!/tests/test_game_state_v1.py
!/tests/test_overlay_http.py
!/tests/test_overlay_lifecycle.py

/src/**/__pycache__/
/src/**/*.pyc
/tools/*
!/tools/adb
!/tools/scrcpy
!/tools/jcc-observe
!/tools/jcc-scene
!/tools/jcc-decision-demo
!/tools/jcc-overlay-demo
!/tools/jcc-annotation-ui
!/tools/历史回放识别检查.command
!/tools/setup-macos

# Local configuration, third-party checkouts, models, captures and environments
# stay outside version control, including if future files are added at root.
